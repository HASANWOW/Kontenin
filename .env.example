# Copy to .env.local and fill in what you have. Every variable is optional —
# without them Kontenin runs fully in Demo Mode. Never commit real secrets.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Signs local (non-Supabase) session cookies. Use a long random string in production.
AUTH_SECRET=

# --- Supabase (auth + database) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Reserved for admin tasks/seeding; not used by the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Text AI (server-only) ---
# Optional: force a provider: openai | gemini | demo. Default: first key found.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Video AI (server-only) ---
WAYINVIDEO_API_KEY=
# Confirm against WayinVideo's API reference before enabling.
WAYINVIDEO_API_BASE_URL=
